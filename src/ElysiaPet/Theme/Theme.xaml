<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         爱莉希雅主题 · 浪漫粉
         配色：深玫瑰侧栏 + 奶油粉底 + 樱粉卡片 + 玫瑰金描边
         ================================================================== -->

    <Color x:Key="AccentColor">#FFE8608C</Color>
    <Color x:Key="AccentDeepColor">#FFC94F76</Color>
    <Color x:Key="AccentSoftColor">#FFFFD9E6</Color>
    <Color x:Key="RoseGoldColor">#FFE7A9C4</Color>
    <Color x:Key="SidebarTopColor">#FF4A2C42</Color>
    <Color x:Key="SidebarBottomColor">#FF2E1B2A</Color>
    <Color x:Key="CanvasColor">#FFFFF5F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="CardPinkColor">#FFFFF0F6</Color>
    <Color x:Key="LineColor">#FFF6D5E2</Color>
    <Color x:Key="TextColor">#FF4A2C3C</Color>
    <Color x:Key="MutedTextColor">#FFA87992</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="RoseGoldBrush" Color="{StaticResource RoseGoldColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardPinkBrush" Color="{StaticResource CardPinkColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="{StaticResource SidebarTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource SidebarBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFF7FB" Offset="0" />
        <GradientStop Color="#FFFFEFF6" Offset="0.5" />
        <GradientStop Color="#FFFDF3F8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF387AC" Offset="0" />
        <GradientStop Color="#FFE8608C" Offset="0.55" />
        <GradientStop Color="#FFD0507E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFF6FA" Offset="1" />
    </LinearGradientBrush>

    <!-- ==================================================================
         字体：标题用行楷（艺术字），正文用幼圆（圆润好读）
         没装这些字体的机器会自动回退到微软雅黑，不会出现方块
         ================================================================== -->
    <FontFamily x:Key="ElysiaTitleFont">华文行楷, STXingkai, 方正舒体, 幼圆, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="ElysiaBodyFont">幼圆, YouYuan, Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="ElysiaAccentFont">华文新魏, STXinwei, 华文行楷, 幼圆, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="UiFont">幼圆, YouYuan, Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>

    <!-- ==================================================================
         全局文字：不设 Foreground，避免压过侧栏的浅色文字
         ================================================================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaTitleFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaTitleFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- 品牌标题：行楷 + 淡淡的粉色发光 -->
    <Style x:Key="BrandTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaTitleFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="#FFFFF0F6" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FFE8608C" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SidebarLinkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#FFE9C4D8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================================================================
         卡片：粉色渐变 + 玫瑰金描边 + 柔和投影
         ================================================================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FFE9A8C6" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         侧栏导航按钮
         ================================================================== -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#FFFFE6F0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="9,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <Path x:Name="Mark" Visibility="Collapsed"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                              Data="M 0,-6 C 4.5,-3 4.5,3 0,6 C -4.5,3 -4.5,-3 0,-6 Z"
                              Fill="#FFFFF3F8" Opacity="0.95" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <Setter TargetName="Bd" Property="Padding" Value="24,0,16,0" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         按钮：粉色渐变圆角
         ================================================================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource AccentGradientBrush}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFE8608C" BlurRadius="14" ShadowDepth="1"
                                                  Direction="270" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="#FFFFF2F7" BorderBrush="{StaticResource RoseGoldBrush}" BorderThickness="1.2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFE3EE" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         输入控件
         ================================================================== -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFBFD" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="FieldCheck" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ==================================================================
         Win11 风格滑动条：圆角细轨 + 粉色进度填充 + 悬停放大的圆形滑块
         ================================================================== -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Halo" Fill="{StaticResource AccentSoftBrush}" Opacity="0"
                                 Width="20" Height="20" />
                        <Ellipse x:Name="Outer" Width="20" Height="20" Fill="White"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                        <Ellipse x:Name="Inner" Fill="{StaticResource AccentBrush}" Width="7" Height="7" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.55" />
                            <Setter TargetName="Inner" Property="Width" Value="11" />
                            <Setter TargetName="Inner" Property="Height" Value="11" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.85" />
                            <Setter TargetName="Inner" Property="Width" Value="13" />
                            <Setter TargetName="Inner" Property="Height" Value="13" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElysiaSlider" TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- PART_Track 必须是 Grid，用两列把轨道限制在滑块可移动区间内 -->
                    <Grid x:Name="PART_Track" VerticalAlignment="Center" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 底轨：只占中间一列 -->
                        <Border Grid.Column="1" Height="8" CornerRadius="4"
                                Background="#FFF3DCE6" VerticalAlignment="Center" />

                        <!-- 粉色进度条：宽度 = 滑块中心相对轨道的偏移 -->
                        <Border x:Name="TrackFill" Grid.Column="0" Grid.ColumnSpan="2"
                                Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentGradientBrush}"
                                Width="{Binding ElementName=ThumbPart, Path=(Canvas.Left)}"
                                Margin="10,0,0,0" />

                        <TickBar x:Name="TopTick" Grid.Column="1" Visibility="Collapsed"
                                 Fill="{StaticResource RoseGoldBrush}" Placement="Top"
                                 Height="4" VerticalAlignment="Top" />
                        <TickBar x:Name="BottomTick" Grid.Column="1" Visibility="Collapsed"
                                 Fill="{StaticResource RoseGoldBrush}" Placement="Bottom"
                                 Height="4" VerticalAlignment="Bottom" />

                        <RepeatButton Grid.Column="0" Command="Slider.DecreaseLarge" Focusable="False"
                                      Opacity="0" Background="Transparent" BorderThickness="0" />
                        <RepeatButton Grid.Column="2" Command="Slider.IncreaseLarge" Focusable="False"
                                      Opacity="0" Background="Transparent" BorderThickness="0" />
                        <Thumb x:Name="ThumbPart" Grid.Column="1" Style="{StaticResource SliderThumbStyle}"
                               Background="{StaticResource AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="BottomRight">
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="Both">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 未指定样式时也用粉色滑动条 -->
    <Style TargetType="Slider" BasedOn="{StaticResource ElysiaSlider}" />

    <!-- ==================================================================
         右键菜单：粉色圆角 + 悬停高亮
         ================================================================== -->
    <Style x:Key="ElysiaMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="6,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="9" Background="Transparent"
                            Padding="{TemplateBinding Padding}" Margin="4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Bullet" Grid.Column="0" Visibility="Collapsed"
                                  Margin="2,0,10,0" VerticalAlignment="Center"
                                  Data="M 0,-5 C 4,-2.5 4,2.5 0,5 C -4,2.5 -4,-2.5 0,-5 Z"
                                  Fill="{StaticResource AccentBrush}" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}" />

                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="18,0,4,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFE7F0" />
                            <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFC9B4BF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElysiaMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,5" Background="{StaticResource LineBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElysiaContextMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="16" Padding="6,8"
                            Background="#FFFFFBFD"
                            BorderBrush="{StaticResource RoseGoldBrush}"
                            BorderThickness="1.4">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD98CB0" BlurRadius="22" ShadowDepth="3"
                                              Direction="270" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 全局生效：未单独指定样式的菜单都用粉色圆角版 -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource ElysiaContextMenu}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource ElysiaMenuItem}" />
    <Style TargetType="Separator" BasedOn="{StaticResource ElysiaMenuSeparator}" />

    <!-- ==================================================================
         列表
         ================================================================== -->
    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFEFF6" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFDCEA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RoseGoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource ElysiaBodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="10" Background="#FFFFF6FA" BorderBrush="{StaticResource RoseGoldBrush}"
                            BorderThickness="1.2" Padding="10,6">
                        <ContentPresenter TextElement.Foreground="{StaticResource TextBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
