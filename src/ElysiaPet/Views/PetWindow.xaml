<Window x:Class="ElysiaPet.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="爱莉希雅桌宠"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Topmost="True"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Width="220" Height="255">

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <!-- 0: 气泡 -->
            <RowDefinition x:Name="BubbleRow" Height="Auto" />
            <!-- 1: 桌宠本体 -->
            <RowDefinition Height="Auto" />
            <!-- 2: 快捷输入框 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 聊天气泡 -->
        <Border x:Name="BubbleBorder"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,4"
                MaxWidth="460"
                CornerRadius="12"
                BorderThickness="2"
                BorderBrush="#FFFFB6C1"
                Background="#F2FFFFFF"
                Visibility="Collapsed"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#FF8A7C90" />
            </Border.Effect>
            <TextBlock x:Name="BubbleText"
                       Margin="18,12"
                       FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                       FontSize="13"
                       Foreground="#FF333333"
                       TextWrapping="Wrap"
                       LineHeight="19" />
        </Border>

        <!-- 桌宠本体（GIF 表情动画） -->
        <Image x:Name="PetImage"
               Grid.Row="1"
               RenderOptions.BitmapScalingMode="HighQuality"
               Stretch="Uniform"
               Cursor="Hand" />

        <!-- 快捷输入框 -->
        <Border x:Name="InputBorder"
                Grid.Row="2"
                Margin="0,6,0,0"
                CornerRadius="10"
                BorderThickness="2"
                BorderBrush="#FFFFB6C1"
                Background="#F2FFFFFF"
                Visibility="Collapsed">
            <TextBox x:Name="InputBox"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="10,6"
                     FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     CaretBrush="#FFE75A7C" />
        </Border>
    </Grid>
</Window>
