<pages:PageBase x:Class="ElysiaPet.Views.Pages.RemindersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⏰ 提醒事项" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="也可以直接对桌宠说「12:00提醒我吃饭」，它会自动记到这里。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListBox x:Name="ReminderList" BorderThickness="0" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="时间" VerticalAlignment="Center" />
            <TextBox x:Name="TimeBox" Style="{StaticResource FieldBox}" Width="80" Margin="8,0"
                     ToolTip="格式 14:30" />
            <TextBlock Text="内容" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox x:Name="ContentBox" Style="{StaticResource FieldBox}" Width="320" Margin="8,0"
                     ToolTip="例如：开会 / 喝水 / 提交报告" />
            <Button Content="➕ 添加" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnAdd" />
            <Button Content="❌ 删除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnDelete" />
            <Button Content="🧹 清空已过期" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnClearPast" />
        </StackPanel>
    </Grid>
</pages:PageBase>
