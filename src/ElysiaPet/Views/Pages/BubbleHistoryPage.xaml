<pages:PageBase x:Class="ElysiaPet.Views.Pages.BubbleHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="❀ 自动冒泡记录" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="待机语录、AI 待机冒泡与整点报时都会记在这里，不会污染对话历史。上限由「系统设置」里的条数控制。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="BubbleList" Grid.Column="0" Margin="0,0,14,0"
                     SelectionChanged="OnBubbleSelectionChanged"
                     MouseRightButtonUp="OnBubbleRightClick" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                             Padding="16" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource UiFont}" FontSize="13" />
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="共" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Text="0" Margin="4,0" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="条冒泡" VerticalAlignment="Center" />
                    <Button Content="✖ 清空全部冒泡" Style="{StaticResource GhostButton}"
                            Margin="18,0,0,0" Click="OnClearAll" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</pages:PageBase>
