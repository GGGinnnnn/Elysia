<pages:PageBase x:Class="ElysiaPet.Views.Pages.ChatHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="💬 历史对话" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="与爱莉希雅的每一轮对话都会记录在这里；在左侧列表上点右键可以删除单条记录。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="HistoryList" Grid.Column="0" Margin="0,0,14,0"
                     SelectionChanged="OnHistorySelectionChanged"
                     MouseRightButtonUp="OnHistoryRightClick" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                             Padding="16" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource UiFont}" FontSize="13" />
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="共" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Text="0" Margin="4,0" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="条记录" VerticalAlignment="Center" />
                    <Button Content="🗑 清空全部对话" Style="{StaticResource GhostButton}"
                            Margin="18,0,0,0" Click="OnClearAll" />
                    <Button Content="📋 复制这条对话" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" Click="OnCopy" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</pages:PageBase>
