<pages:PageBase x:Class="ElysiaPet.Views.Pages.ChimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔔 整点报时设置" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="每行一条，格式为  小时|语录  ，例如  09|九点整啦，早安~ 。同一个小时可以写多条，报时会随机挑一句。" />
            <CheckBox x:Name="ChimeCheck" Style="{StaticResource FieldCheck}"
                      Content="开启整点报时" Checked="OnChimeToggled" Unchecked="OnChimeToggled" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="ChimeEditor" AcceptsReturn="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Padding="14"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="💾 保存报时语录" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            <Button Content="↩️ 放弃修改" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnRevert" />
            <Button Content="🔍 校验格式" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnValidate" />
            <Button Content="🧪 随机试听一句" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnPreview" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>
    </Grid>
</pages:PageBase>
