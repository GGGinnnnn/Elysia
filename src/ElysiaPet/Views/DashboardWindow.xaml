<Window x:Class="ElysiaPet.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
        Title="爱莉希雅 · 桌宠管理后台"
        Width="960" Height="640"
        MinWidth="820" MinHeight="540"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,14">
                    <TextBlock Text="🎀 爱莉希雅" FontSize="17" FontWeight="Bold"
                               Foreground="White" Margin="22,0,0,2" />
                    <TextBlock Text="桌宠管理后台 v2" FontSize="11"
                               Foreground="#FFB9AEC4" Margin="22,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="配置：config.json"
                           FontSize="10" Foreground="#FF8C8299" Margin="22,0,0,16" />

                <StackPanel>
                    <RadioButton x:Name="NavChat" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="💬 历史对话" Checked="OnNavChecked" Tag="ChatHistory" IsChecked="True" />
                    <RadioButton x:Name="NavBubble" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="🍃 自动冒泡" Checked="OnNavChecked" Tag="BubbleHistory" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="⚙️ 系统设置" Checked="OnNavChecked" Tag="Settings" />
                    <RadioButton x:Name="NavReminders" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="⏰ 提醒事项" Checked="OnNavChecked" Tag="Reminders" />
                    <RadioButton x:Name="NavChime" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="🔔 报时设置" Checked="OnNavChecked" Tag="Chime" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="🚀 快捷启动" Checked="OnNavChecked" Tag="QuickApps" />
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="❓ 功能说明" Checked="OnNavChecked" Tag="Help" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="ℹ️ 关于" Checked="OnNavChecked" Tag="About" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="0" Margin="0" />

            <Border Grid.Row="1" Background="#FFFFF0F4" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="18,8">
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}"
                           Text="小提示：右键点击托盘图标或桌宠本体，都能快速打开这里。" />
            </Border>
        </Grid>
    </Grid>
</Window>
