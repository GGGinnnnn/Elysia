<Window x:Class="ElysiaPet.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ElysiaPet.Views.Pages"
        Title="爱莉希雅 · 桌宠管理后台"
        Width="1000" Height="680"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource ElysiaBodyFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- 品牌区 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,16">
                    <TextBlock Text="❀ 爱莉希雅" Style="{StaticResource BrandTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="桌宠管理后台 ♪ v2.1" FontSize="11.5"
                               Foreground="#FFF0C6DB" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    <Border Height="1" Margin="26,12,26,0" Background="#55FFD9E6" />
                </StackPanel>

                <!-- 底部：项目地址 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Border Height="1" Margin="0,0,0,12" Background="#44FFD9E6" />
                    <TextBlock Text="✧ 项目地址" Style="{StaticResource SidebarLinkText}" />
                    <TextBlock x:Name="ProjectLink" Style="{StaticResource SidebarLinkText}"
                               Margin="0,3,0,0" Cursor="Hand" TextDecorations="Underline"
                               ToolTip="点击用浏览器打开 GitHub 仓库"
                               MouseLeftButtonUp="OnProjectLinkClick" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SidebarLinkText}"
                               Margin="0,8,0,0" Foreground="#B8E9C4D8" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavChat" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="❝ 历史对话" Checked="OnNavChecked" Tag="ChatHistory" IsChecked="True" />
                    <RadioButton x:Name="NavBubble" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="❀ 自动冒泡" Checked="OnNavChecked" Tag="BubbleHistory" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="✿ 系统设置" Checked="OnNavChecked" Tag="Settings" />
                    <RadioButton x:Name="NavReminders" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="◷  提醒事项" Checked="OnNavChecked" Tag="Reminders" />
                    <RadioButton x:Name="NavChime" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="♪ 报时设置" Checked="OnNavChecked" Tag="Chime" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="➤ 快捷启动" Checked="OnNavChecked" Tag="QuickApps" />
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="❓  功能说明" Checked="OnNavChecked" Tag="Help" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Content="❤  关于" Checked="OnNavChecked" Tag="About" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <StaticResource ResourceKey="CanvasGradientBrush" />
            </Grid.Background>

            <!-- 花瓣与柔光的载体：由代码在加载时填充 PetalsOverlay -->
            <Grid x:Name="EffectLayer" IsHitTestVisible="False" />
            <Grid x:Name="ContentLayer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0" Margin="0" />

                <Border Grid.Row="1" Background="#E6FFF0F6" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0" Padding="20,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❀ " Foreground="{StaticResource AccentBrush}" FontSize="13" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource HintText}"
                                   Foreground="{StaticResource AccentDeepBrush}"
                                   Text="小提示：右键点击托盘图标或桌宠本体，都能快速打开这里。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
